{
  "name": "modeler-suite",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "workspaces": [
    "packages/*",
    "modelers/*",
    "modelers/*/packages/*",
    "modelers/*/apps/*",
    "modelers/*/e2e",
    "extensions/*"
  ],
  "scripts": {
    "build": "npm run build:shared && npm run build:modelers && npm run build:apps",
    "build:shared": "npm run build -w @miragon/modeler-api -w @miragon/modeler-shell",
    "build:modelers": "npm run modelers build",
    "build:apps": "npm run modelers build:webapp && npm run modelers build:vscode",
    "package:vscode": "npm run modelers package:vscode",
    "typecheck": "npm run typecheck:shared && npm run modelers typecheck",
    "typecheck:shared": "npm run typecheck -w @miragon/modeler-api -w @miragon/modeler-shell && tsc -p test/tsconfig.json",
    "lint": "npm run typecheck:shared && npm run modelers lint",
    "test": "npm run test:shared && npm run modelers test",
    "test:shared": "npm run test -w @miragon/modeler-api -w @miragon/modeler-shell && npm run test:plugin",
    "test:plugin": "vitest run --config test/vitest.config.mts",
    "check:release-notes": "node .github/scripts/release-notes/check-pull-request.mjs",
    "test:browser": "npm run test:browser:shared && npm run modelers test:browser",
    "test:browser:shared": "npm run test:browser -w @miragon/modeler-shell",
    "test:e2e": "npm run test:e2e:shared && npm run modelers test:e2e",
    "test:e2e:shared": "npm run test:e2e -w @miragon/modeler-shell",
    "depcruise": "npm run modelers depcruise",
    "publint": "npm run publint -w @miragon/modeler-api -w @miragon/modeler-shell",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "modelers": "npm run -w @miragon/wardley-maps-modeler-workspace -w @miragon/event-storming-modeler-workspace -w @miragon/team-topologies-modeler-workspace -w @miragon/context-maps-modeler-workspace -w @miragon/value-chain-modeler-workspace -w @miragon/c4-modeler-workspace -w @miragon/business-model-canvas-modeler-workspace",
    "wardley-maps": "npm run -w @miragon/wardley-maps-modeler-workspace",
    "event-storming": "npm run -w @miragon/event-storming-modeler-workspace",
    "team-topologies": "npm run -w @miragon/team-topologies-modeler-workspace",
    "context-maps": "npm run -w @miragon/context-maps-modeler-workspace",
    "value-chain": "npm run -w @miragon/value-chain-modeler-workspace",
    "c4": "npm run -w @miragon/c4-modeler-workspace",
    "business-model-canvas": "npm run -w @miragon/business-model-canvas-modeler-workspace",
    "prepare": "husky"
  },
  "lint-staged": {
    "{modelers,plugins}/**/*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "{packages,test}/**/*.{ts,tsx}": "prettier --write",
    "*.{js,mjs,cjs,json,jsonc,md,yaml,yml,css,html}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/semver": "7.8.0",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "65.4.5",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "release-please": "17.6.0",
    "semver": "7.8.6",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "@types/node": "26.6.6",
    "minimatch": "11.0.3",
    "vite": "8.3.7"
  }
}
