{
  "name": "@miragon/__REPO__",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "workspaces": [
    "packages/schema-model",
    "packages/dsl",
    "packages/renderer",
    "apps/webapp",
    "apps/vscode",
    "e2e"
  ],
  "scripts": {
    "build": "npm run build -w packages/schema-model -w packages/dsl -w packages/renderer",
    "build:webapp": "npm run build -w apps/webapp",
    "build:vscode": "npm run build -w apps/vscode",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/webapp/tsconfig.config.json && npm run typecheck -w apps/vscode && npm run typecheck -w e2e",
    "lint": "eslint . && npm run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project=unit",
    "test:browser": "vitest run --project=browser",
    "test:e2e": "npm run test:e2e -w e2e --",
    "test:vscode-smoke": "vitest run --config apps/vscode/test-smoke/vitest.config.ts",
    "test:vscode": "npm run build && npm run build:vscode && npm run test:vscode-smoke",
    "test:vscode:docker": "modeler-shell-vscode-docker --env VSCODE_VERSION --env VSCODE_SMOKE_KEEP --env VSCODE_SMOKE_SKIP",
    "dev": "npm run dev:webapp",
    "dev:webapp": "npm run dev -w apps/webapp",
    "dev:webapp:plain": "npm run dev:app -w apps/webapp",
    "dev:vscode": "npm run watch -w apps/vscode",
    "depcruise": "depcruise packages apps --config .dependency-cruiser.cjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,md,yaml,yml,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@vitest/browser-playwright": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
