{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@miragon/__NOTATION__-schema-model": ["./packages/schema-model/src/index.ts"],
      "@miragon/__NOTATION__-dsl": ["./packages/dsl/src/index.ts"],
      "@miragon/__NOTATION__-renderer": ["./packages/renderer/src/index.ts"],
      "@miragon/__NOTATION__-renderer/themes": ["./packages/renderer/src/themes.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/test/**/*.ts"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**", "apps/vscode/**"]
}
