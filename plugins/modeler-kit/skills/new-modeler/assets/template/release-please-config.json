{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bump-minor-pre-major": true,
  "separate-pull-requests": false,
  "include-component-in-tag": true,
  "initial-version": "0.1.0",
  "plugins": [{ "type": "node-workspace", "updatePeerDependencies": true }],
  "packages": {
    "packages/schema-model": { "component": "schema-model" },
    "packages/dsl": { "component": "dsl" },
    "packages/renderer": { "component": "renderer" },
    "apps/ide-editor": { "component": "ide-editor" },
    "apps/vscode": { "component": "vscode" },
    "apps/orca": {
      "component": "orca",
      "extra-files": [{ "type": "json", "path": "orca-plugin.json", "jsonpath": "$.version" }]
    },
    "apps/webapp": { "component": "webapp" }
  }
}
