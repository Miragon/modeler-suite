{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "event-storming-modeler",
  "name": "Event Storming Modeler",
  "version": "0.0.0",
  "description": "Open .storm files as Event Storming boards: model with stickies, notes and arrows, and see an agent's changes to the file as they happen.",
  "author": {
    "name": "Miragon GmbH",
    "url": "https://www.miragon.io"
  },
  "repository": "https://github.com/Miragon/modeler-suite",
  "homepage": "https://miragon.github.io/modeler-suite/",
  "license": "MIT",
  "icon": "assets/icon.png",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "sandboxed-ui",
  "pluginApi": 1,
  "contributes": {
    "customEditors": [
      {
        "id": "event-storming",
        "title": "Event Storming",
        "extensions": [
          ".storm"
        ],
        "entry": "editor/index.html",
        "frame": "isolated"
      }
    ]
  }
}
