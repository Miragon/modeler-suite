{
  "name": "@miragon/context-maps-webapp",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Context Maps Modeler web application (Vite demo editor).",
  "scripts": {
    "dev": "PORTLESS_HTTPS=0 PORTLESS_PORT=8080 portless",
    "dev:app": "vite --host 127.0.0.1 --port ${PORT:-5181}",
    "build": "vite build",
    "preview": "vite preview",
    "check:build": "node scripts/check-build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@miragon/context-maps-cml": "0.1.6",
    "@miragon/context-maps-renderer": "0.6.1",
    "@miragon/context-maps-schema-model": "0.4.1",
    "@miragon/modeler-shell": "0.6.0",
    "diagram-js": "15.28.1",
    "didi": "12.0.0",
    "lz-string": "1.5.0",
    "tiny-svg": "4.1.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "portless": "0.15.8"
  }
}
