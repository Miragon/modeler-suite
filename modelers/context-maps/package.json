{
  "name": "@miragon/context-maps-modeler-workspace",
  "version": "0.0.1",
  "private": true,
  "description": "A web-based modeler and VS Code extension for DDD Context Maps (bounded contexts & context-mapping relationship patterns), interoperable with Context Mapper CML.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "modelerSuite": {
    "domFreePackages": [
      "schema-model",
      "cml"
    ]
  },
  "scripts": {
    "build": "npm run build -w packages/schema-model -w packages/cml -w packages/renderer",
    "build:webapp": "npm run build -w apps/webapp",
    "build:vscode": "npm run build -w apps/vscode",
    "build:orca": "npm run build -w apps/orca",
    "package:vscode": "npm run package -w apps/vscode",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/webapp/tsconfig.node.json && npm run typecheck -w apps/ide-editor && npm run typecheck -w apps/vscode && npm run typecheck -w apps/orca && npm run typecheck -w e2e",
    "lint": "eslint . && npm run typecheck",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "test": "vitest run --project=unit",
    "test:browser": "vitest run --project=browser",
    "test:vscode": "vitest run --project=vscode",
    "test:vscode:docker": "modeler-shell-vscode-docker --results modelers/context-maps/test-results/vscode-smoke",
    "test:orca": "vitest run --project=orca",
    "test:orca:docker": "modeler-shell-orca-docker --results modelers/context-maps/test-results/orca-smoke",
    "test:e2e": "npm run test:e2e -w e2e --",
    "dev": "npm run dev:webapp",
    "dev:webapp": "npm run dev -w apps/webapp",
    "dev:webapp:plain": "npm run dev:app -w apps/webapp",
    "dev:vscode": "npm run watch -w apps/vscode",
    "depcruise": "depcruise packages apps --config .dependency-cruiser.cjs"
  }
}
