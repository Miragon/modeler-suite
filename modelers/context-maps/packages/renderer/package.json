{
  "name": "@miragon/context-maps-renderer",
  "version": "0.8.0",
  "description": "Render and edit Context Maps diagrams in the browser, with a framework-agnostic viewer and modeler built on diagram-js.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/modeler-suite.git",
    "directory": "modelers/context-maps/packages/renderer"
  },
  "homepage": "https://github.com/Miragon/modeler-suite/tree/main/modelers/context-maps/packages/renderer#readme",
  "bugs": "https://github.com/Miragon/modeler-suite/issues",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./assets/context-maps.css": "./dist/context-maps.css",
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm --prefix ../.. run test",
    "test:browser": "npm --prefix ../.. run test:browser"
  },
  "dependencies": {
    "@miragon/context-maps-schema-model": "0.5.1",
    "@miragon/modeler-api": "1.6.0",
    "diagram-js-direct-editing": "3.6.0"
  },
  "peerDependencies": {
    "diagram-js": "^15.26.0",
    "didi": "^11.0.0 || ^12.0.0",
    "tiny-svg": "^4.1.4",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "diagram-js": "15.28.1",
    "didi": "12.0.0",
    "tiny-svg": "4.1.4",
    "vite-plugin-dts": "5.1.2",
    "zod": "4.6.7"
  }
}
