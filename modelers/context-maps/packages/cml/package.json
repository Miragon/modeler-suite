{
  "name": "@miragon/context-maps-cml",
  "version": "0.1.6",
  "description": "Convert between the Context Mapper CML text format and the Context Maps model (import/export of the strategic-DDD context-mapping subset).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/modeler-suite.git",
    "directory": "modelers/context-maps/packages/cml"
  },
  "homepage": "https://github.com/Miragon/modeler-suite/tree/main/modelers/context-maps/packages/cml#readme",
  "bugs": "https://github.com/Miragon/modeler-suite/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm --prefix ../.. run test"
  },
  "dependencies": {
    "@miragon/context-maps-schema-model": "0.4.1"
  }
}
