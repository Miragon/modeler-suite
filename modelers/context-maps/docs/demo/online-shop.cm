{
  "version": 1,
  "title": "Online shop: context map",
  "contexts": [
    {
      "id": "ctx_advisor",
      "label": "Product Advisor",
      "position": {
        "x": 940,
        "y": 40
      },
      "size": {
        "width": 200,
        "height": 110
      },
      "subdomainType": "core",
      "team": "Pricing Team",
      "description": "Personalised product suggestions from browsing and order history."
    },
    {
      "id": "ctx_catalog",
      "label": "Product Catalog",
      "position": {
        "x": 340,
        "y": 40
      },
      "size": {
        "width": 200,
        "height": 110
      },
      "subdomainType": "supporting",
      "team": "Merchandising Team",
      "description": "Products, variants and media, published to every sales channel."
    },
    {
      "id": "ctx_checkout",
      "label": "Checkout",
