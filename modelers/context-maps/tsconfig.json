{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Authoritative whole-repo typecheck for the packages + webapp (source paths, no build needed). apps/vscode and e2e are typechecked separately via their own tsconfigs (see the root `typecheck` script).",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@miragon/context-maps-schema-model": ["packages/schema-model/src/index.ts"],
      "@miragon/context-maps-cml": ["packages/cml/src/index.ts"],
      "@miragon/context-maps-renderer": ["packages/renderer/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/renderer/test", "apps/webapp/src", "apps/webapp/test"],
  "exclude": [
    "**/dist/**",
    "**/node_modules/**",
    "apps/vscode/**",
    "apps/ide-editor/**",
    "apps/orca/**",
    "e2e/**"
  ]
}
