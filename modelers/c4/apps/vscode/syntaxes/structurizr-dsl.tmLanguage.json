    },
    "text-block": {
      "comment": "Opened by a line that ends with \"\"\", closed by the next line that ends with it.",
      "name": "string.quoted.triple.structurizr-dsl",
      "begin": "(\"\"\")$",
      "beginCaptures": { "1": { "name": "punctuation.definition.string.begin.structurizr-dsl" } },
      "end": "(\"\"\")$",
      "endCaptures": { "1": { "name": "punctuation.definition.string.end.structurizr-dsl" } },
      "patterns": [{ "include": "#substitution" }]
