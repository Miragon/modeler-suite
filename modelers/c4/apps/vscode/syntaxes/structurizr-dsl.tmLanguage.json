      "endCaptures": { "1": { "name": "punctuation.definition.string.end.structurizr-dsl" } },
      "patterns": [
        { "name": "constant.character.escape.structurizr-dsl", "match": "\\\\[\"n]" },
        { "include": "#substitution" },
        { "include": "#colour" },
        { "include": "#url" }
      ]
    },
    "substitution": {
      "name": "variable.other.substitution.structurizr-dsl",
      "match": "\\$\\{[A-Za-z0-9_.-]+?\\}"
    },
    "expression": {
      "patterns": [
        {
          "match": "(?i)(?<![A-Za-z0-9_.-])(element)(\\.)(type)(==|!=)(Person|SoftwareSystem|Container|Component|DeploymentNode|InfrastructureNode|SoftwareSystemInstance|ContainerInstance|Custom)(?![A-Za-z0-9_])",
