        { "include": "#directives" },
        {
          "match": "^\\s*([^\\s\"{}][^\\s\"]*)(?=\\s)",
          "captures": { "1": { "name": "variable.other.property.structurizr-dsl" } }
        },
        { "include": "#values" }
      ]
    },
    "values": {
      "patterns": [
        { "include": "#text-block" },
        { "include": "#string" },
        { "include": "#substitution" },
