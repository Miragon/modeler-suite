        { "name": "keyword.operator.relationship.structurizr-dsl", "match": "->" },
        { "name": "keyword.operator.comparison.structurizr-dsl", "match": "==|!=" },
        { "name": "keyword.operator.logical.structurizr-dsl", "match": "&&|\\|\\|" },
        { "name": "keyword.operator.wildcard.structurizr-dsl", "match": "\\*\\?|\\*" },
        { "name": "keyword.operator.assignment.structurizr-dsl", "match": "(?<!\\S)=(?=\\s|$)" },
