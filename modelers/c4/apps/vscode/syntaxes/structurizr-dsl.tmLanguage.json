    "string": {
      "comment": "A quote opens a string only where a token starts; \\\" is a quote and \\n a line break, there is no other escape.",
      "name": "string.quoted.double.structurizr-dsl",
      "begin": "(?<![^\\s\"])(\")",
      "beginCaptures": { "1": { "name": "punctuation.definition.string.begin.structurizr-dsl" } },
