        { "include": "#directives" },
        {
          "match": "(?i)^\\s*(person|softwareSystem|container|component|deploymentNode|infrastructureNode|relationship|metadata)(?=\\s|$)",
          "captures": { "1": { "name": "keyword.other.terminology.structurizr-dsl" } }
