      "end": "^\\s*(\\})(.*)$",
      "endCaptures": {
        "1": { "name": "punctuation.section.block.end.structurizr-dsl" },
        "2": { "name": "comment.line.ignored.structurizr-dsl" }
      },
      "patterns": [{ "include": "#configuration-body" }]
    },
    "configuration-body": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#directives" },
        { "include": "#properties-block" },
        {
          "name": "meta.block.users.structurizr-dsl",
          "begin": "(?i)^\\s*(users)(?=\\s|$)(.*?)\\s(\\{)\\s*$",
          "beginCaptures": {
            "1": { "name": "keyword.other.block.structurizr-dsl" },
