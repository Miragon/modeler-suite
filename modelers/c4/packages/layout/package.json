{
  "name": "@miragon/c4-layout",
  "version": "0.0.0",
  "description": "Lay out C4 views automatically and place new elements next to their neighbours, without the DOM.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/modeler-suite.git",
    "directory": "modelers/c4/packages/layout"
  },
  "homepage": "https://github.com/Miragon/modeler-suite/tree/main/modelers/c4/packages/layout#readme",
  "bugs": "https://github.com/Miragon/modeler-suite/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
