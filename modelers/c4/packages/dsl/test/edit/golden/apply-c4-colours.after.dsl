workspace {
    model {
        customer = person "Customer"
    }
    views {
        styles {
            element "Person" {
                shape person
                background #08427b
                color "#FFFFFF"
                stroke "#052E57"
            }
            element "Software System" {
                background "#1168BD"
                color "#FFFFFF"
                stroke "#0B4F91"
            }
            element "Container" {
                background "#2D72B8"
                color "#FFFFFF"
                stroke "#1F5A96"
            }
            element "Component" {
                background "#85BBF0"
                color "#1D1D1D"
                stroke "#4F86C0"
            }
            element "Existing System" {
                background "#6B6B6B"
                color "#FFFFFF"
                stroke "#4D4D4D"
            }
        }
    }
}
