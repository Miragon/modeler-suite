{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "value-chain-modeler",
  "name": "Value Chain Modeler",
  "version": "0.1.3",
  "description": "Open .vc and .vc.json files as value chain diagrams: model process steps, org units and their connections, and see an agent's changes to the file as they happen.",
  "author": {
    "name": "Miragon GmbH",
    "url": "https://www.miragon.io"
  },
  "repository": "https://github.com/Miragon/modeler-suite",
  "homepage": "https://miragon.github.io/modeler-suite/",
  "license": "MIT",
  "icon": "assets/icon.png",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "sandboxed-ui",
  "pluginApi": 1,
  "contributes": {
    "customEditors": [
      {
        "id": "value-chain",
        "title": "Value Chain",
        "extensions": [
          ".vc",
          ".vc.json"
        ],
        "entry": "editor/index.html",
        "frame": "isolated"
      }
    ]
  }
}
