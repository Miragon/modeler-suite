{
  "name": "@miragon/board-renderer",
  "version": "0.1.0",
  "private": true,
  "description": "View and edit a board in the browser: a canvas of a repository's own files that implements @miragon/modeler-api.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./assets/board.css": "./src/assets/board.css",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm --prefix ../.. run test",
    "test:browser": "npm --prefix ../.. run test:browser"
  },
  "dependencies": {
    "@miragon/board-schema-model": "0.1.0",
    "@miragon/modeler-api": "1.7.0",
    "@xyflow/react": "12.12.1",
    "dompurify": "3.4.17",
    "lucide-react": "1.70.0",
    "markdown-it": "15.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
