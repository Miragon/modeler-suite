{
  "name": "@miragon/board-schema-model",
  "version": "0.2.0",
  "description": "The board document model: the file format (one JSON line per element), its strict reader, the elements of a board and what a canvas draws of them.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/modeler-suite.git",
    "directory": "modelers/board/packages/schema-model"
  },
  "homepage": "https://github.com/Miragon/modeler-suite/tree/main/modelers/board/packages/schema-model#readme",
  "bugs": "https://github.com/Miragon/modeler-suite/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm --prefix ../.. run test"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
