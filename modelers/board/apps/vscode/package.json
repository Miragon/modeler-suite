{
  "name": "board-modeler",
  "private": true,
  "version": "0.0.0",
  "displayName": "Board Modeler",
  "description": "View and edit boards directly in VS Code: a canvas of a repository's own files, with its models edited in place, as plain-text *.board files.",
  "publisher": "miragon-gmbh",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/modeler-suite.git",
    "directory": "modelers/board/apps/vscode"
  },
  "bugs": "https://github.com/Miragon/modeler-suite/issues",
  "homepage": "https://github.com/Miragon/modeler-suite/tree/main/modelers/board/apps/vscode#readme",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "board",
    "canvas",
    "whiteboard",
    "architecture",
    "modeling"
  ],
  "main": "./dist/extension.cjs",
  "type": "module",
  "activationEvents": [
    "onCustomEditor:board.boardEditor"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "board.boardEditor",
        "displayName": "Board",
        "selector": [
          {
            "filenamePattern": "*.board"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "vscode:prepublish": "node esbuild.config.mjs --production",
    "package": "vsce package --no-dependencies -o board-modeler.vsix"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@miragon/board-files": "0.0.0",
    "@miragon/board-host": "0.0.0",
    "@miragon/board-renderer": "0.0.0",
    "@miragon/board-schema-model": "0.0.0",
    "@miragon/modeler-shell": "0.14.2",
    "board-ide-editor": "0.0.0",
    "board-suite-editors": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.65.0",
    "typescript": "6.0.3"
  }
}
