<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_order" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.23.0">
  <bpmn:process id="Process_order_to_cash" name="Order to cash" isExecutable="true">
    <bpmn:startEvent id="Start_order_received" name="Order received">
      <bpmn:outgoing>Flow_to_check</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_check_order" name="Check order">
      <bpmn:incoming>Flow_to_check</bpmn:incoming>
      <bpmn:outgoing>Flow_to_gateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_in_stock" name="In stock?">
      <bpmn:incoming>Flow_to_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ship_order" name="Ship order">
      <bpmn:incoming>Flow_yes</bpmn:incoming>
      <bpmn:outgoing>Flow_to_shipped</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_order_shipped" name="Order shipped">
      <bpmn:incoming>Flow_to_shipped</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_notify_customer" name="Notify customer">
      <bpmn:incoming>Flow_no</bpmn:incoming>
      <bpmn:outgoing>Flow_to_declined</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_order_declined" name="Order declined">
      <bpmn:incoming>Flow_to_declined</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_to_check" sourceRef="Start_order_received" targetRef="Task_check_order" />
    <bpmn:sequenceFlow id="Flow_to_gateway" sourceRef="Task_check_order" targetRef="Gateway_in_stock" />
    <bpmn:sequenceFlow id="Flow_yes" name="yes" sourceRef="Gateway_in_stock" targetRef="Task_ship_order" />
    <bpmn:sequenceFlow id="Flow_no" name="no" sourceRef="Gateway_in_stock" targetRef="Task_notify_customer" />
    <bpmn:sequenceFlow id="Flow_to_shipped" sourceRef="Task_ship_order" targetRef="End_order_shipped" />
    <bpmn:sequenceFlow id="Flow_to_declined" sourceRef="Task_notify_customer" targetRef="End_order_declined" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_order">
    <bpmndi:BPMNPlane id="Plane_order" bpmnElement="Process_order_to_cash">
      <bpmndi:BPMNShape id="Start_order_received_di" bpmnElement="Start_order_received">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="134" y="145" width="72" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_check_order_di" bpmnElement="Task_check_order">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_in_stock_di" bpmnElement="Gateway_in_stock" isMarkerVisible="true">
        <dc:Bounds x="395" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="396" y="65" width="48" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ship_order_di" bpmnElement="Task_ship_order">
        <dc:Bounds x="500" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_order_shipped_di" bpmnElement="End_order_shipped">
        <dc:Bounds x="662" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="645" y="145" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_notify_customer_di" bpmnElement="Task_notify_customer">
        <dc:Bounds x="500" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_order_declined_di" bpmnElement="End_order_declined">
        <dc:Bounds x="662" y="232" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="644" y="275" width="72" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_to_check_di" bpmnElement="Flow_to_check">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_gateway_di" bpmnElement="Flow_to_gateway">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="395" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_yes_di" bpmnElement="Flow_yes">
        <di:waypoint x="445" y="120" />
        <di:waypoint x="500" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="464" y="102" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_no_di" bpmnElement="Flow_no">
        <di:waypoint x="420" y="145" />
        <di:waypoint x="420" y="250" />
        <di:waypoint x="500" y="250" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="428" y="193" width="14" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_shipped_di" bpmnElement="Flow_to_shipped">
        <di:waypoint x="600" y="120" />
        <di:waypoint x="662" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_declined_di" bpmnElement="Flow_to_declined">
        <di:waypoint x="600" y="250" />
        <di:waypoint x="662" y="250" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
