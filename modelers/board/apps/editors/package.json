{
  "name": "board-suite-editors",
  "version": "0.3.1",
  "private": true,
  "description": "The seven modelers of the suite as editors in a board's model nodes: the registry, each notation's text rules, and the build helpers of the board's apps. The one workspace of the board that depends on another modeler.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/registry.ts"
    },
    "./suffixes": "./src/suffixes.ts",
    "./base": "./src/base.ts",
    "./zod-jitless": "./src/zod-jitless.ts",
    "./build/*": "./build/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@miragon/board-host": "0.3.1",
    "@miragon/bpmn-modeler": "1.10.0",
    "@miragon/business-model-canvas-dsl": "0.3.0",
    "@miragon/business-model-canvas-renderer": "0.3.0",
    "@miragon/c4-renderer": "0.2.1",
    "@miragon/context-maps-renderer": "0.10.1",
    "@miragon/context-maps-schema-model": "0.5.1",
    "@miragon/event-storming-renderer": "0.11.0",
    "@miragon/modeler-api": "2.0.0",
    "@miragon/team-topologies-renderer": "0.23.0",
    "@miragon/team-topologies-schema-model": "0.23.0",
    "@miragon/value-chain-renderer": "0.11.1",
    "@miragon/value-chain-schema-model": "0.7.3",
    "@miragon/wardley-dsl": "0.10.0",
    "@miragon/wardley-renderer": "0.19.0",
    "@miragon/wardley-schema-model": "0.6.1",
    "diagram-js": "15.30.1",
    "didi": "12.0.0",
    "moddle-xml": "12.3.2",
    "tiny-svg": "4.1.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
