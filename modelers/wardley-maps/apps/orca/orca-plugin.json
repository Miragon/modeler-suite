{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "wardley-maps-modeler",
  "name": "Wardley Maps Modeler",
  "version": "0.1.1",
  "description": "Open .wmap and .owm files as Wardley maps: place components on the evolution axis, draw their dependencies, and see an agent's changes to the file as they happen.",
  "author": {
    "name": "Miragon GmbH",
    "url": "https://www.miragon.io"
  },
  "repository": "https://github.com/Miragon/modeler-suite",
  "homepage": "https://miragon.github.io/modeler-suite/",
  "license": "MIT",
  "icon": "assets/icon.png",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "sandboxed-ui",
  "pluginApi": 1,
  "contributes": {
    "customEditors": [
      {
        "id": "wardley-maps",
        "title": "Wardley Map",
        "extensions": [
          ".wmap",
          ".owm"
        ],
        "entry": "editor/index.html",
        "frame": "isolated"
      }
    ]
  }
}
