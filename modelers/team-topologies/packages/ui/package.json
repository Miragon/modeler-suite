{
  "name": "@miragon/team-topologies-ui",
  "version": "0.14.0",
  "private": true,
  "description": "The inspector panel the Team Topologies web app and VS Code webview mount into their chrome; the menu entries, legend rows and dialogs come from the renderer.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./ui.css": "./src/styles/ui.css",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm --prefix ../.. run test"
  },
  "dependencies": {
    "@miragon/team-topologies-renderer": "0.14.0",
    "@miragon/team-topologies-schema-model": "0.14.0",
    "diagram-js": "15.28.1",
    "lucide-react": "1.59.0"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3"
  }
}
