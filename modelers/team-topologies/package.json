{
  "name": "@miragon/team-topologies-modeler-workspace",
  "version": "0.14.0",
  "private": true,
  "description": "A web-based modeler and VS Code extension for the Team Topologies notation (team types & interaction modes).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "modelerSuite": {
    "domFreePackages": [
      "schema-model"
    ]
  },
  "scripts": {
    "build": "npm run build -w packages/schema-model -w packages/renderer",
    "build:webapp": "npm run build -w apps/webapp",
    "build:vscode": "npm run build -w apps/vscode",
    "package:vscode": "npm run package -w apps/vscode",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/webapp/tsconfig.node.json && npm run typecheck -w apps/vscode && npm run typecheck -w e2e",
    "lint": "eslint . && npm run typecheck",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "test": "vitest run --project=unit",
    "test:browser": "vitest run --project=browser",
    "test:vscode": "vitest run --project=vscode --silent=false",
    "test:vscode:docker": "modeler-shell-vscode-docker --results modelers/team-topologies/test-results/vscode-smoke",
    "test:e2e": "npm run test:e2e -w e2e",
    "dev": "npm run dev:webapp",
    "dev:webapp": "npm run dev -w apps/webapp",
    "dev:webapp:plain": "npm run dev:app -w apps/webapp",
    "dev:vscode": "npm run watch -w apps/vscode",
    "depcruise": "depcruise packages apps --config .dependency-cruiser.cjs",
    "check:release-notes": "node scripts/release-notes/check-pull-request.mjs"
  },
  "devDependencies": {
    "@miragon/modeler-shell": "0.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vscode/test-electron": "3.1.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "playwright-core": "1.64.1",
    "release-please": "17.6.0"
  }
}
