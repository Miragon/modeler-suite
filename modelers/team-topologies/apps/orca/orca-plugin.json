{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "team-topologies-modeler",
  "name": "Team Topologies Modeler",
  "version": "0.18.3",
  "description": "Open .tt and .ttm.json files as Team Topologies diagrams: model teams, their interactions and the flow of change, and see an agent's changes to the file as they happen.",
  "author": {
    "name": "Miragon GmbH",
    "url": "https://www.miragon.io"
  },
  "repository": "https://github.com/Miragon/modeler-suite",
  "homepage": "https://miragon.github.io/modeler-suite/",
  "license": "MIT",
  "icon": "assets/icon.png",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "sandboxed-ui",
  "pluginApi": 1,
  "contributes": {
    "customEditors": [
      {
        "id": "team-topologies",
        "title": "Team Topologies",
        "extensions": [
          ".tt",
          ".ttm.json"
        ],
        "entry": "editor/index.html",
        "frame": "isolated"
      }
    ]
  }
}
